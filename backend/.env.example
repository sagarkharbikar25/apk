# =============================================
# SkillSync Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# --- App ---
PORT=3000
NODE_ENV=development

# --- JWT ---
JWT_SECRET=change_me_to_a_64_char_random_string
JWT_REFRESH_SECRET=change_me_to_another_64_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:[PASSWORD]@[HOST].upstash.io:6379

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Firebase (FCM) ---
# Stringify the service account JSON: JSON.stringify(require('./service-account.json'))
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# --- Supabase Storage ---
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:19000

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
