// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum Role {
  student
  organizer
}

enum LookingFor {
  teammate
  team
  both
  not_looking
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  expert
}

enum HackathonStatus {
  draft
  open
  closed
  completed
}

enum InvitationStatus {
  pending
  accepted
  declined
  expired
}

// ─── 1. Users ──────────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          Role      @default(student)
  emailVerified Boolean   @default(false) @map("email_verified")
  fcmToken      String?   @map("fcm_token")
  isActive      Boolean   @default(true) @map("is_active")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  profile                Profile?
  userSkills             UserSkill[]
  createdTeams           Team[]                  @relation("TeamCreator")
  teamMembers            TeamMember[]
  sentInvitations        TeamInvitation[]        @relation("Inviter")
  receivedInvitations    TeamInvitation[]        @relation("Invitee")
  organizedHackathons    Hackathon[]
  hackathonRegistrations HackathonRegistration[]
  notifications          Notification[]
  refreshTokens          RefreshToken[]

  @@index([email])
  @@map("users")
}

// ─── 2. Profiles ───────────────────────────────────────────────

model Profile {
  id             String      @id @default(uuid())
  userId         String      @unique @map("user_id")
  displayName    String      @map("display_name")
  bio            String?
  college        String?
  graduationYear Int?        @map("graduation_year")
  avatarUrl      String?     @map("avatar_url")
  githubUrl      String?     @map("github_url")
  linkedinUrl    String?     @map("linkedin_url")
  portfolioUrl   String?     @map("portfolio_url")
  location       String?
  lookingFor     LookingFor? @default(both) @map("looking_for")
  preferredRoles String[]    @default([]) @map("preferred_roles")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lookingFor])
  @@map("profiles")
}

// ─── 3. Skills ─────────────────────────────────────────────────

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  aliases   String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  userSkills         UserSkill[]
  teamRequiredSkills TeamRequiredSkill[]

  @@index([name])
  @@index([category])
  @@map("skills")
}

// ─── 4. User Skills ────────────────────────────────────────────

model UserSkill {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  skillId   String     @map("skill_id")
  level     SkillLevel
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

// ─── 5. Hackathons ─────────────────────────────────────────────

model Hackathon {
  id                   String          @id @default(uuid())
  organizerId          String          @map("organizer_id")
  title                String
  description          String?
  venue                String?
  startDate            DateTime        @map("start_date")
  endDate              DateTime        @map("end_date")
  registrationDeadline DateTime        @map("registration_deadline")
  maxTeamSize          Int             @default(4) @map("max_team_size")
  status               HackathonStatus @default(open)
  isActive             Boolean         @default(true) @map("is_active")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  organizer     User                    @relation(fields: [organizerId], references: [id])
  teams         Team[]
  registrations HackathonRegistration[]

  @@index([status, startDate])
  @@index([organizerId])
  @@map("hackathons")
}

// ─── 6. Hackathon Registrations ────────────────────────────────

model HackathonRegistration {
  id          String   @id @default(uuid())
  hackathonId String   @map("hackathon_id")
  userId      String   @map("user_id")
  checkedIn   Boolean  @default(false) @map("checked_in")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  hackathon Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([hackathonId, userId])
  @@index([userId])
  @@map("hackathon_registrations")
}

// ─── 7. Teams ──────────────────────────────────────────────────

model Team {
  id          String    @id @default(uuid())
  hackathonId String    @map("hackathon_id")
  creatorId   String    @map("creator_id")
  name        String
  description String?
  maxMembers  Int       @default(4) @map("max_members")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  hackathon      Hackathon           @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  creator        User                @relation("TeamCreator", fields: [creatorId], references: [id])
  members        TeamMember[]
  requiredSkills TeamRequiredSkill[]
  invitations    TeamInvitation[]

  @@unique([id, hackathonId])
  @@index([hackathonId])
  @@index([creatorId])
  @@map("teams")
}

// ─── 8. Team Required Skills ───────────────────────────────────

model TeamRequiredSkill {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([teamId, skillId])
  @@map("team_required_skills")
}

// ─── 9. Team Members ───────────────────────────────────────────

model TeamMember {
  id          String   @id @default(uuid())
  teamId      String   @map("team_id")
  hackathonId String   @map("hackathon_id")
  userId      String   @map("user_id")
  role        String?
  isLeader    Boolean  @default(false) @map("is_leader")
  joinedAt    DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId, hackathonId], references: [id, hackathonId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@unique([hackathonId, userId])
  @@index([userId])
  @@map("team_members")
}

// ─── 10. Team Invitations ──────────────────────────────────────

model TeamInvitation {
  id        String           @id @default(uuid())
  teamId    String           @map("team_id")
  inviterId String           @map("inviter_id")
  inviteeId String           @map("invitee_id")
  status    InvitationStatus @default(pending)
  expiresAt DateTime         @map("expires_at")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("Inviter", fields: [inviterId], references: [id])
  invitee User @relation("Invitee", fields: [inviteeId], references: [id])

  @@index([inviteeId, status])
  @@map("team_invitations")
}

// ─── 11. Notifications ─────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

// ─── 12. Refresh Tokens ────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}
