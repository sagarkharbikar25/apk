# ============================================================
# SkillSync — Root Environment Variables Template
# ============================================================

# --- Supabase PostgreSQL Database ---
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# --- Supabase Storage & Service Key ---
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL="https://[HOST].upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
REDIS_URL="rediss://default:[PASSWORD]@[HOST].upstash.io:6379"

# --- Google Gemini AI ---
GEMINI_API_KEY="your_gemini_api_key"

# --- Backend Application ---
PORT=3000
NODE_ENV=development
JWT_SECRET="skillsync_jwt_super_secret_key_development_min_32_chars"
JWT_REFRESH_SECRET="skillsync_jwt_refresh_super_secret_key_development_min_32_chars"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Mobile App API Base URL ---
EXPO_PUBLIC_API_URL="http://localhost:3000/api/v1"
